{
  "name": "blablatex-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0 && prettier . --check",
    "format": "prettier . --write",
    "test": "vitest run",
    "gen:api": "openapi-typescript ../backend/openapi.json -o src/api/schema.d.ts"
  },
  "dependencies": {
    "@codemirror/language": "6.13.1",
    "@codemirror/legacy-modes": "6.5.5",
    "@codemirror/merge": "6.12.3",
    "@codemirror/search": "6.7.2",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.15",
    "@hookform/resolvers": "7.0.1",
    "@lezer/highlight": "1.2.5",
    "@microsoft/fetch-event-source": "2.0.1",
    "@tanstack/react-query": "5.105.1",
    "@uiw/react-codemirror": "4.25.12",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "katex": "0.16.47",
    "lucide-react": "1.66.0",
    "openapi-fetch": "0.17.0",
    "pdfjs-dist": "6.3.289",
    "radix-ui": "1.8.1",
    "react": "19.3.1",
    "react-arborist": "4.0.1",
    "react-dom": "19.3.1",
    "react-hook-form": "7.91.0",
    "react-markdown": "10.1.0",
    "react-pdf": "11.0.0",
    "react-resizable-panels": "4.16.1",
    "react-router": "^8.5.1",
    "rehype-katex": "7.0.1",
    "remark-math": "6.0.0",
    "sonner": "2.0.8",
    "tailwind-merge": "3.7.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "6.2.1",
    "eslint": "10.14.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "globals": "17.14.0",
    "jsdom": "30.1.3",
    "msw": "3.0.3",
    "openapi-typescript": "7.13.0",
    "prettier": "3.9.10",
    "tailwindcss": "^4.3.3",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.1",
    "undici": "8.12.3",
    "vite": "8.3.5",
    "vite-plugin-static-copy": "4.1.1",
    "vitest": "5.0.5"
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  }
}
