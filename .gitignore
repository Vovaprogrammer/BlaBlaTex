# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.ruff_cache/
.pytest_cache/
.coverage
htmlcov/

# Node
node_modules/
dist/
build/

# IDE
.vscode/
.idea/
*.swp
*.swo
.claude/settings.local.json

# LaTeX: артефакты локальной сборки шаблонов (логи-фикстуры в тестах не трогаем)
templates/**/*.log
templates/**/*.aux
templates/**/*.out
templates/**/*.toc
templates/**/*.synctex.gz
templates/**/*.fls
templates/**/*.fdb_latexmk
templates/**/*.xdv

# Хранилище бэкенда в dev (STORAGE_DIR): артефакты сборок и загруженные файлы
# Сама папка storage есть в репозитории: иначе на Linux её создал бы Docker при монтировании
# в воркер — от root, и ни воркер, ни API на хосте не смогли бы в неё писать.
backend/data/**
!backend/data/storage/
!backend/data/storage/.gitkeep

# OS
.DS_Store
Thumbs.db
desktop.ini

# Secrets
.env
.env.*
!.env.example
*.key
*.pem

# Docker
docker-compose.override.yml
