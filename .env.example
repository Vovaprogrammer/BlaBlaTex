# Скопируйте в .env и заполните. Пустое значение — значение по умолчанию.
# Реальный .env не коммитится.

# --- Бэкенд ---
# dev | test | prod, по умолчанию dev
APP_ENV=
# DEBUG | INFO | WARNING | ERROR | CRITICAL, по умолчанию INFO
LOG_LEVEL=

# --- Postgres: общие для docker compose и бэкенда ---
# по умолчанию blablatex
POSTGRES_USER=
# обязательно
POSTGRES_PASSWORD=
# по умолчанию blablatex; тесты на время прогона создают рядом свою базу <POSTGRES_DB>_test_<номер процесса>
POSTGRES_DB=
# порт на localhost, по умолчанию 5432
POSTGRES_PORT=
# где бэкенд ищет Postgres, по умолчанию localhost
POSTGRES_HOST=
# пул соединений бэкенда, по умолчанию 5 и ещё до 10 сверх него
DB_POOL_SIZE=
DB_MAX_OVERFLOW=

# --- Хранилище файлов бэкенда (PDF и логи сборок, загруженные файлы) ---
# папка на диске, по умолчанию backend/data/storage; её же монтирует воркер в docker compose,
# поэтому свой путь — только абсолютный
STORAGE_DIR=

# --- Redis в docker compose: очередь задач воркера и события проектов ---
# порт на localhost, по умолчанию 6379
REDIS_PORT=
# адрес Redis для бэкенда; пусто — redis://localhost:<REDIS_PORT>/0,
# бэкенд внутри docker compose — redis://redis:6379/0
REDIS_URL=

# --- Компилятор в docker compose ---
# порт на localhost, через который бэкенд в dev ходит к компилятору, по умолчанию 8080
COMPILER_PORT=
# адрес компилятора для бэкенда; пусто — http://localhost:<COMPILER_PORT>,
# бэкенд внутри docker compose — http://compiler:8080
COMPILER_URL=

# --- Агент ---
# лимит токенов на один прогон агента (вход и выход вместе), по умолчанию 200000
AGENT_RUN_MAX_TOKENS=

# --- LLM ---
# Без этих переменных API работает, а чат отвечает «Модель для чата не настроена».
# LLM_PROVIDERS — JSON одной строкой: OpenAI-совместимые провайдеры, у каждого модели для
# ролей main (чат), fast и vision и цены за миллион входных/выходных токенов в USD
# (нужны для учёта расхода). Ключ — только здесь, в .env, в git его не коммитить.
# Модель main должна уметь вызывать инструменты и принимать картинки: агент смотрит
# скриншоты из materials/.
# LLM_PROVIDERS={"openrouter":{"base_url":"https://openrouter.ai/api/v1","api_key":"<ключ>","timeout":90,"models":{"main":{"name":"anthropic/claude-haiku-5.5","input_price":0.1,"output_price":0.5},"fast":{"name":"anthropic/claude-haiku-5.5","input_price":0.1,"output_price":0.5},"vision":{"name":"anthropic/claude-haiku-5.5","input_price":0.1,"output_price":0.5}}}}
# имя основного провайдера из LLM_PROVIDERS
# LLM_DEFAULT_PROVIDER=openrouter
# резервный провайдер (другое имя из LLM_PROVIDERS) — на него переходят при 5xx и таймаутах
# LLM_FALLBACK_PROVIDER=

# --- Свой ключ LLM студента ---
# ключ шифрования своих ключей студентов (Fernet); пусто — свой ключ сохранить нельзя.
# Создать: uv run python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Сменить: новый ключ — первым через запятую (новый,старый), перезапустить API и воркер,
# uv run python -m app.scripts.rotate_llm_keys, потом убрать старый и перезапустить снова
APP_ENCRYPTION_KEY=

# --- Материалы ---
# описывать скриншоты из materials/ vision-моделью (true или false), по умолчанию false:
# каждое описание стоит денег
MATERIAL_DESCRIBE_IMAGES=
