# Скопируйте в .env и заполните. Пустое значение — значение по умолчанию.
# Реальный .env не коммитится.

# --- Бэкенд ---
# dev | test | prod, по умолчанию dev
APP_ENV=
# DEBUG | INFO | WARNING | ERROR | CRITICAL, по умолчанию INFO
LOG_LEVEL=

# --- Postgres в docker compose ---
# по умолчанию blablatex
POSTGRES_USER=
# обязательно
POSTGRES_PASSWORD=
# по умолчанию blablatex
POSTGRES_DB=
# порт на localhost, по умолчанию 5432
POSTGRES_PORT=

# --- Redis в docker compose ---
# порт на localhost, по умолчанию 6379
REDIS_PORT=
