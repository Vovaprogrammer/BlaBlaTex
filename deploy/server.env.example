# Настройки BlaBlaTex на сервере вуза (docs/deploy.md). Скопируйте в .env рядом с compose.yaml
# и compose.server.yaml. Пустое значение — значение по умолчанию.

# Оба файла сразу: тогда хватает `docker compose up -d --wait`.
COMPOSE_FILE=compose.yaml:compose.server.yaml

# Домен сайта, например blablatex.mtuci.ru: сертификат HTTPS Caddy получит сам. Домен должен
# смотреть на этот сервер, а порты 80 и 443 — быть открыты.
# Если HTTPS держит свой прокси вуза перед BlaBlaTex — «:80» и подсеть прокси в BBT_TRUSTED_PROXIES.
BBT_DOMAIN=
# Подсети прокси вуза перед Caddy через пробел, например 10.0.0.5/32. Пусто — прокси нет.
BBT_TRUSTED_PROXIES=

# Версия образов, например 2.0.0. Пусто — версия этого файла compose.yaml.
BBT_VERSION=
# Откуда брать образы, если у вуза своё зеркало. Пусто — ghcr.io/vovaprogrammer.
BBT_REGISTRY=

# Бэкап: время по Москве, сколько последних хранить и куда класть (том backups или папка
# на сервере, принадлежащая uid 1000).
BBT_BACKUP_AT=
BBT_BACKUP_KEEP=
BBT_BACKUP_DIR=

# Подсеть между Caddy и API внутри Docker. Менять, только если 10.255.255.0/28 уже занята.
BBT_EDGE_SUBNET=

# --- ИИ в чате на сайте (architecture.md 8) ---
# Провайдер из РФ (ADR 0003): JSON одной строкой, формат — в .env.example в репозитории.
LLM_PROVIDERS=
LLM_DEFAULT_PROVIDER=
LLM_FALLBACK_PROVIDER=
# Дневной лимит токенов на студента, по умолчанию 500000.
LLM_DAILY_TOKEN_LIMIT=

# Только на время смены ключа шифрования: «новый,старый» (docs/deploy.md).
APP_ENCRYPTION_KEY=

# DEBUG | INFO | WARNING | ERROR, по умолчанию INFO.
LOG_LEVEL=
